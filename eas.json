{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "development-phone": {
      "extends": "development",
      "env": {
        "STANDOUT_PHONE_ONLY": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6833097670"
      }
    }
  }
}
